# Copy to `.env`. Docker Compose reads it, and so does `pnpm --filter @opencourse/api dev`.
# The values below are development defaults; change every secret before a real deployment.

# --- Postgres ---
POSTGRES_USER=opencourse
POSTGRES_PASSWORD=opencourse
POSTGRES_DB=opencourse

# --- Object storage (S3-compatible) ---
S3_ACCESS_KEY=opencourse
S3_SECRET_KEY=opencourse-secret
S3_BUCKET=opencourse
# Address browsers use to reach the storage: uploads and video segments go straight to it, so it
# must be reachable from the internet in a real deployment (and allow your web origin, see docs/video.md).
S3_PUBLIC_URL=http://localhost:9000
# Address the API and the worker use to reach the storage, and its region (defaults shown).
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# Largest video file an instructor can upload, in bytes (2 GiB).
VIDEO_MAX_UPLOAD_BYTES=2147483648
# Largest lesson attachment an instructor can upload, in bytes (50 MiB).
ATTACHMENT_MAX_BYTES=52428800

# --- Auth ---
# Signs access tokens. Required, at least 32 characters. The API REFUSES to start in production
# with this placeholder: generate your own with `openssl rand -base64 48`.
AUTH_SECRET=replace-this-with-a-long-random-secret-before-deploying
# Set to true when the API is served over HTTPS (cookies then carry the Secure flag).
COOKIE_SECURE=false
# Set to true only behind a reverse proxy you control, so rate limits see the real client IP.
TRUST_PROXY=false
# Serves the API reference at /docs and the OpenAPI document at /docs/openapi.json. Set to false
# to hide them (the routes then answer 404).
API_DOCS_ENABLED=true

# Lifetime of a session: the access token (seconds, at least 30) and the rotating refresh token (days).
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# Address and port the API listens on.
# HOST=0.0.0.0
# PORT=3000

# --- Web app address (CORS and the links inside e-mails) ---
CORS_ORIGINS=http://localhost:5173
WEB_BASE_URL=http://localhost:5173
# Address the browser uses to reach the API. Docker Compose bakes it into the web bundle at build
# time (default below), so rebuild the web image after changing it.
# VITE_API_URL=http://localhost:3000

# --- SMTP (e-mails: invites, recovery, certificates) ---
# Unset, e-mails go to Mailpit, which only captures them (inbox at http://localhost:8025). Mailpit runs
# only in development: `docker compose --profile dev up -d`. Without it and without a server below, sending fails.
# Uncomment and fill in to deliver to real inboxes. Settings saved by an admin in the app override these,
# except the password, which always comes from here.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=OpenCourse <no-reply@example.com>

# --- Webhooks ---
# Outbound webhooks refuse loopback, private and link-local destinations and plain http. Set to true
# only to reach receivers on your own network (n8n, another container) and only if you trust every admin.
WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false

# --- API, when run outside Docker (`pnpm --filter @opencourse/api dev`) ---
DATABASE_URL=postgres://opencourse:opencourse@localhost:5432/opencourse
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

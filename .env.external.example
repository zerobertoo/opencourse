# For compose.app.yaml: you run Postgres, Redis and an S3-compatible storage yourself.
#   cp .env.external.example .env.external
#   docker compose --env-file .env.external -f compose.app.yaml up -d --build --wait
# Use addresses the containers can reach (not `localhost`, which is the container itself;
# on Docker Desktop `host.docker.internal` points at the host).

# --- Your infrastructure ---
DATABASE_URL=postgres://user:password@host.docker.internal:5432/opencourse
REDIS_URL=redis://host.docker.internal:6379
# The bucket must already exist and allow your web origin (CORS), see docs/video.md.
S3_ENDPOINT=http://host.docker.internal:9000
S3_BUCKET=opencourse
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
# Address browsers use to reach the storage.
S3_PUBLIC_URL=http://localhost:9000

# --- SMTP (e-mails: invites, recovery, certificates) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OpenCourse <no-reply@example.com>

# --- Auth and web app address ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-this-with-a-long-random-secret-before-deploying
COOKIE_SECURE=false
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173
WEB_BASE_URL=http://localhost:5173
# Address of the API as browsers reach it; it is baked into the web bundle at build time.
VITE_API_URL=http://localhost:3000

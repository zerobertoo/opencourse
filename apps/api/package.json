{
  "name": "@opencourse/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsdown",
    "start": "node dist/server.js",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed:demo": "tsx --env-file-if-exists=../../.env src/db/seed-demo.ts",
    "certificates:backfill": "tsx --env-file-if-exists=../../.env src/modules/certificates/backfill.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@node-rs/argon2": "^2.2.2",
    "@opencourse/shared": "workspace:^",
    "@scalar/fastify-api-reference": "^1.77.0",
    "bullmq": "^6.7.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
